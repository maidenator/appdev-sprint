<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                <NotAuthorized>
                    <div class="card p-5 text-center my-5 rounded-4 bg-white">
                        <h3 class="text-dark">Clinic admin authorization required</h3>
                        <p class="text-muted">Log in as an authorized clinic administrator to view the inquiries inbox.</p>
                        <div class="d-flex justify-content-center gap-3 mt-3">
                            <a href="Identity/Account/Login?returnUrl=/admin" class="btn btn-primary">
                                Login to clinic portal
                            </a>
                            <a href="/" class="btn btn-outline-secondary">
                                Return home
                            </a>
                        </div>
                    </div>
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
    </Router>
</CascadingAuthenticationState>
