@inherits LayoutComponentBase

<div class="hub-shell">
    <header class="hub-header">
        <div class="hub-header-inner">
            <a class="hub-brand" href="">
                <span class="hub-mark" aria-hidden="true">CEBU</span>
                <span class="hub-word">Dental Hub <span class="hub-sub">Metro Cebu</span></span>
            </a>
            <NavMenu />
            <div class="hub-header-actions">
                <span class="hub-locale d-none d-lg-inline">Prices in <strong>₱ PHP</strong> · GMT+8</span>
                <a href="request" class="btn btn-primary btn-sm hub-cta">Get free quote</a>
            </div>
        </div>
    </header>

    <main>
        <article class="content hub-content">
            @Body
        </article>

        <footer class="hub-footer">
            <div class="hub-footer-inner">
                <p class="hub-footer-areas"><strong>Cebu Dental Hub</strong> — Metro Cebu · Talisay · Minglanilla · Naga · Carcar · Consolacion · Liloan · Compostela · Danao</p>
                <p class="hub-footer-note">Clinic names and areas are real directory listings. Prices, availability, and all other details are illustrative demo anchors — confirm a written quote with the clinic in Philippine Pesos (PHP).</p>
            </div>
        </footer>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
