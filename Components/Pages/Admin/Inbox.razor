@page "/admin"
@page "/admin/inbox"
@attribute [Authorize(Roles = "ClinicAdmin")]
@using appdev_sprint.Components.Shared
@using appdev_sprint.Models
@using appdev_sprint.Services
@inject InquiryService InquiryService
@inject ClinicCatalogService CatalogService

<PageTitle>Clinic Admin Inbox & Patient Inquiries — Cebu Dental Hub</PageTitle>

<div class="mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center">
        <div>
            <span class="badge bg-dark text-warning mb-1 px-3 py-1">Clinic Administration</span>
            <h1 class="h2 fw-bold mb-0" style="color: #0a2540;">Clinic Portal & Inquiry Inbox</h1>
        </div>
        <div class="mt-2 mt-sm-0">
            <span class="badge bg-success-subtle text-success border border-success p-2">
                <i class="bi bi-shield-lock-fill me-1"></i> Authorized: ClinicAdmin Role Active
            </span>
        </div>
    </div>
</div>

<!-- Tabs: Inquiries vs Clinic Profile -->
<ul class="nav nav-pills mb-4 gap-2">
    <li class="nav-item">
        <button class="nav-link @(activeTab == "inbox" ? "active" : "") fw-bold" @onclick='() => activeTab = "inbox"'>
            <i class="bi bi-inbox me-1"></i> Patient Inquiries (@inquiries.Count)
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(activeTab == "catalog" ? "active" : "") fw-bold" @onclick='() => activeTab = "catalog"'>
            <i class="bi bi-building me-1"></i> Clinics & Procedure Catalog
        </button>
    </li>
</ul>

@if (activeTab == "inbox")
{
    <!-- Metrics Cards Row -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-primary border-4">
                <div class="small text-muted fw-bold text-uppercase">Total Inquiries</div>
                <div class="h3 fw-bold mb-0 text-primary">@inquiries.Count</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-info border-4">
                <div class="small text-muted fw-bold text-uppercase">New Inquiries</div>
                <div class="h3 fw-bold mb-0 text-info">@inquiries.Count(i => i.Status == InquiryStatus.New)</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-warning border-4">
                <div class="small text-muted fw-bold text-uppercase">Quotes Sent</div>
                <div class="h3 fw-bold mb-0 text-warning">@inquiries.Count(i => i.Status == InquiryStatus.Quoted)</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-success border-4">
                <div class="small text-muted fw-bold text-uppercase">Accepted Bookings</div>
                <div class="h3 fw-bold mb-0 text-success">@inquiries.Count(i => i.Status == InquiryStatus.Accepted)</div>
            </div>
        </div>
    </div>

    <!-- Filter Buttons Bar -->
    <div class="d-flex flex-wrap gap-2 mb-3 align-items-center">
        <span class="small fw-bold text-muted me-2">Filter by Status:</span>
        <button class="btn btn-sm @(selectedFilterStatus == null ? "btn-dark" : "btn-outline-secondary")" @onclick="() => FilterByStatus(null)">
            All (@inquiries.Count)
        </button>
        <button class="btn btn-sm @(selectedFilterStatus == InquiryStatus.New ? "btn-info text-white" : "btn-outline-info")" @onclick="() => FilterByStatus(InquiryStatus.New)">
            New (@inquiries.Count(i => i.Status == InquiryStatus.New))
        </button>
        <button class="btn btn-sm @(selectedFilterStatus == InquiryStatus.Quoted ? "btn-warning text-dark" : "btn-outline-warning")" @onclick="() => FilterByStatus(InquiryStatus.Quoted)">
            Quoted (@inquiries.Count(i => i.Status == InquiryStatus.Quoted))
        </button>
        <button class="btn btn-sm @(selectedFilterStatus == InquiryStatus.Accepted ? "btn-success" : "btn-outline-success")" @onclick="() => FilterByStatus(InquiryStatus.Accepted)">
            Accepted (@inquiries.Count(i => i.Status == InquiryStatus.Accepted))
        </button>
        <button class="btn btn-sm @(selectedFilterStatus == InquiryStatus.Declined ? "btn-danger" : "btn-outline-danger")" @onclick="() => FilterByStatus(InquiryStatus.Declined)">
            Declined (@inquiries.Count(i => i.Status == InquiryStatus.Declined))
        </button>
    </div>

    <!-- Inquiries Cards / Table -->
    @if (filteredInquiries.Count == 0)
    {
        <div class="card p-5 text-center bg-white border-0 shadow-sm rounded-3">
            <h5 class="fw-bold text-muted mb-1">No Inquiries Found</h5>
            <p class="small text-muted mb-0">No patient requests match the current status filter.</p>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3 mb-5">
            @foreach (var inq in filteredInquiries)
            {
                <div class="card border-0 shadow-sm rounded-3 p-4 bg-white">
                    <div class="d-flex flex-wrap justify-content-between align-items-start mb-3">
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <h5 class="fw-bold mb-0 text-dark">@inq.PatientName</h5>
                                <span class="badge bg-light text-dark border">@inq.HomeCountry</span>
                                @switch (inq.Status)
                                {
                                    case InquiryStatus.New:
                                        <span class="badge bg-info text-white">New Request</span>
                                        break;
                                    case InquiryStatus.Quoted:
                                        <span class="badge bg-warning text-dark">Quote Issued</span>
                                        break;
                                    case InquiryStatus.Accepted:
                                        <span class="badge bg-success">Booking Accepted</span>
                                        break;
                                    case InquiryStatus.Declined:
                                        <span class="badge bg-secondary">Declined</span>
                                        break;
                                }
                            </div>
                            <div class="text-muted small mt-1">
                                Reference: <strong>CEB-INQ-@inq.Id.ToString("D4")</strong> &bull;
                                Submitted: @inq.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm") &bull;
                                Contact: <strong class="text-dark">@inq.Contact</strong>
                            </div>
                        </div>

                        <!-- Status Transition Controls -->
                        <div class="d-flex flex-wrap gap-2 mt-2 mt-sm-0">
                            @if (inq.Status == InquiryStatus.New)
                            {
                                <button class="btn btn-sm btn-warning text-dark fw-bold" @onclick="() => UpdateInquiryStatus(inq.Id, InquiryStatus.Quoted)">
                                    Send Quote &rarr;
                                </button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => UpdateInquiryStatus(inq.Id, InquiryStatus.Declined)">
                                    Decline
                                </button>
                            }
                            else if (inq.Status == InquiryStatus.Quoted)
                            {
                                <button class="btn btn-sm btn-success fw-bold" @onclick="() => UpdateInquiryStatus(inq.Id, InquiryStatus.Accepted)">
                                    Accept Booking ✓
                                </button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => UpdateInquiryStatus(inq.Id, InquiryStatus.Declined)">
                                    Decline
                                </button>
                            }
                            else if (inq.Status == InquiryStatus.Accepted)
                            {
                                <span class="badge bg-success-subtle text-success border border-success p-2 small">
                                    ✓ Booking Confirmed
                                </span>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => UpdateInquiryStatus(inq.Id, InquiryStatus.New)">
                                    Reopen
                                </button>
                            }
                        </div>
                    </div>

                    <!-- Details Box -->
                    <div class="row g-3 p-3 rounded-2 bg-light small mb-2">
                        <div class="col-md-4">
                            <span class="text-muted d-block">Target Clinic:</span>
                            <strong class="text-dark">@(inq.Clinic?.Name ?? $"Clinic #{inq.ClinicId}")</strong>
                        </div>
                        <div class="col-md-4">
                            <span class="text-muted d-block">Procedure:</span>
                            <strong class="text-dark">@(inq.Procedure != null ? $"{inq.Procedure.Type} (₱{inq.Procedure.PricePhp:N0})" : $"Procedure #{inq.ProcedureId}")</strong>
                        </div>
                        <div class="col-md-4">
                            <span class="text-muted d-block">Preferred Date & Party:</span>
                            <span class="text-dark">
                                @(inq.PreferredDate?.ToString("MMM dd, yyyy") ?? "Flexible")
                                (@inq.CompanionCount companion@(inq.CompanionCount == 1 ? "" : "s"))
                            </span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(inq.Notes))
                        {
                            <div class="col-12 border-top pt-2 mt-2">
                                <span class="text-muted d-block">Patient Notes & Dental History:</span>
                                <div class="text-secondary fst-italic">"@inq.Notes"</div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
}
else
{
    <!-- Clinic Catalog Overview Tab -->
    <div class="card border-0 shadow-sm rounded-3 p-4 bg-white mb-5">
        <h4 class="h5 fw-bold mb-3" style="color: #0a2540;">Registered Metro Cebu Dental Centers</h4>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-uppercase">
                    <tr>
                        <th>Clinic Name</th>
                        <th>Location</th>
                        <th>Accreditations</th>
                        <th>Implant Systems</th>
                        <th>Active Procedures</th>
                        <th>Contact</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in catalogClinics)
                    {
                        <tr>
                            <td>
                                <strong>@c.Name</strong>
                                @if (c.IsHospitalDepartment)
                                {
                                    <span class="badge bg-primary ms-1" style="font-size: 0.65rem;">Hospital</span>
                                }
                            </td>
                            <td>@c.Area, @c.City</td>
                            <td>
                                @foreach (var acc in c.Accreditations.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <span class="badge bg-light text-dark border me-1">@acc</span>
                                }
                            </td>
                            <td><span class="badge badge-system">@c.ImplantSystems</span></td>
                            <td>
                                <span class="badge bg-secondary">@c.Procedures.Count Procedures</span>
                                <span class="small text-muted ms-1">from ₱@(c.Procedures.Count > 0 ? c.Procedures.Min(p => p.PricePhp).ToString("N0") : "0")</span>
                            </td>
                            <td class="small text-muted">@c.Contact</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private string activeTab = "inbox";
    private List<Inquiry> inquiries = new();
    private List<Inquiry> filteredInquiries = new();
    private List<Clinic> catalogClinics = new();
    private InquiryStatus? selectedFilterStatus;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        inquiries = await InquiryService.GetInboxAsync();
        catalogClinics = await CatalogService.GetClinicsAsync();
        ApplyFilter();
    }

    private void FilterByStatus(InquiryStatus? status)
    {
        selectedFilterStatus = status;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (selectedFilterStatus.HasValue)
        {
            filteredInquiries = inquiries.Where(i => i.Status == selectedFilterStatus.Value).ToList();
        }
        else
        {
            filteredInquiries = inquiries;
        }
    }

    private async Task UpdateInquiryStatus(int id, InquiryStatus newStatus)
    {
        await InquiryService.UpdateStatusAsync(id, newStatus);
        await LoadData();
    }
}
