@page "/request"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using appdev_sprint.Components.Shared
@using appdev_sprint.Models
@using appdev_sprint.Services
@inject ClinicCatalogService CatalogService
@inject InquiryService InquiryService

<PageTitle>Request a Free Quote — Cebu Dental Hub</PageTitle>

<div class="row justify-content-center">
    <div class="col-lg-8 col-md-10">
        @if (isSubmitted && submittedInquiry != null)
        {
            <!-- Success Confirmation Screen -->
            <div class="card rounded-4 p-5 text-center bg-white my-4">
                <div class="mb-3">
                    <span class="rounded-circle d-inline-flex align-items-center justify-content-center bg-success-subtle text-success" style="width: 72px; height: 72px; font-size: 2rem;" aria-hidden="true">
                        <i class="bi bi-check-lg"></i>
                    </span>
                </div>

                <p class="text-muted mb-1">Inquiry transmitted</p>
                <h1 class="mb-2">Your inquiry has been received</h1>
                <p class="text-muted mb-4">
                    Reference ID: <strong class="text-dark">CEB-INQ-@submittedInquiry.Id.ToString("D4")</strong>
                </p>

                <div class="card bg-light border p-4 text-start mb-4 rounded-3">
                    <h6 class="fw-bold text-dark mb-3 border-bottom pb-2">Treatment Plan Summary:</h6>
                    <div class="row g-2 small">
                        <div class="col-sm-6">
                            <span class="text-muted">Patient Name:</span>
                            <strong class="d-block text-dark">@submittedInquiry.PatientName</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted">Home Country:</span>
                            <strong class="d-block text-dark">@submittedInquiry.HomeCountry</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted">Selected Clinic:</span>
                            <strong class="d-block text-dark">@confirmedClinicName</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted">Requested Procedure:</span>
                            <strong class="d-block text-dark">@confirmedProcName</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted">Preferred Visit Date:</span>
                            <strong class="d-block text-dark">@(submittedInquiry.PreferredDate?.ToString("MMMM dd, yyyy") ?? "Flexible")</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted">Companions Coming Along:</span>
                            <strong class="d-block text-dark">@submittedInquiry.CompanionCount companion@(submittedInquiry.CompanionCount == 1 ? "" : "s")</strong>
                        </div>
                    </div>
                </div>

                <!-- Next Steps Timeline -->
                <div class="text-start mb-4">
                    <h6 class="fw-bold text-dark mb-2">What Happens Next:</h6>
                    <ol class="small text-muted ps-3 mb-0">
                        <li class="mb-1"><strong>Doctor Evaluation (Within 24 Hours):</strong> The clinic’s chief dental surgeon evaluates your requirements and requests any digital X-rays or photos.</li>
                        <li class="mb-1"><strong>Formal Written Quote:</strong> You receive an itemized, binding treatment quote in Philippine Pesos (PHP).</li>
                        <li><strong>Appointment Assistance:</strong> The clinic confirms your slot and sends directions with parking and landmark guidance.</li>
                    </ol>
                </div>

                <div class="d-flex justify-content-center gap-3">
                    <a href="clinics" class="btn btn-outline-secondary">Browse more clinics</a>
                    <button class="btn btn-primary" @onclick="ResetForm">
                        Submit another inquiry
                    </button>
                </div>
            </div>
        }
        else
        {
            <!-- Inquiry Form Header -->
            <div class="mb-4 text-center">
                <h1 class="mb-2">Request a free written treatment plan</h1>
                <p class="text-muted">Itemized quote in Philippine Pesos directly from licensed dental specialists in Metro Cebu. No booking fees.</p>
            </div>

            <div class="card rounded-4 p-4 p-md-5 bg-white mb-4">
                <EditForm Model="@model" OnValidSubmit="@HandleValidSubmit">
                    <DataAnnotationsValidator />

                    <div class="row g-3">
                        <!-- Clinic Dropdown -->
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Select Cebu Dental Clinic *</label>
                            <InputSelect class="form-select" @bind-Value="model.ClinicId" @bind-Value:after="OnClinicSelectionChanged">
                                <option value="0">-- Choose a clinic --</option>
                                @foreach (var c in clinics)
                                {
                                    <option value="@c.Id">@c.Name (@c.Area)</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => model.ClinicId)" class="text-danger small mt-1" />
                        </div>

                        <!-- Procedure Dropdown -->
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Requested Procedure *</label>
                            <InputSelect class="form-select" @bind-Value="model.ProcedureId">
                                <option value="0">-- Choose procedure --</option>
                                @foreach (var p in availableProcedures)
                                {
                                    <option value="@p.Id">@p.Type — ₱@p.PricePhp.ToString("N0") PHP</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => model.ProcedureId)" class="text-danger small mt-1" />
                        </div>

                        <!-- Patient Name -->
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Full Name *</label>
                            <InputText class="form-control" @bind-Value="model.PatientName" placeholder="e.g. John Smith" />
                            <ValidationMessage For="@(() => model.PatientName)" class="text-danger small mt-1" />
                        </div>

                        <!-- Contact Details -->
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted" for="req-contact">Email address or phone *</label>
                            <InputText id="req-contact" class="form-control" @bind-Value="model.Contact" placeholder="e.g. john@example.com or +1 415-555-0100" />
                            <div class="form-text">Clinic replies here — double-check spelling.</div>
                            <ValidationMessage For="@(() => model.Contact)" class="text-danger small mt-1" />
                        </div>

                        <!-- Based In -->
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-muted">Where Are You Based? *</label>
                            <InputSelect class="form-select" @bind-Value="model.HomeCountry">
                                <option value="Cebu City">Cebu City</option>
                                <option value="Mandaue City">Mandaue City</option>
                                <option value="Lapu-Lapu City">Lapu-Lapu City</option>
                                <option value="Elsewhere in Cebu">Elsewhere in Cebu</option>
                                <option value="Outside Cebu">Outside Cebu</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => model.HomeCountry)" class="text-danger small mt-1" />
                        </div>

                        <!-- Preferred Visit Date -->
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-muted" for="req-date">Preferred visit date</label>
                            <InputDate id="req-date" class="form-control" @bind-Value="model.PreferredDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            <ValidationMessage For="@(() => model.PreferredDate)" class="text-danger small mt-1" />
                        </div>

                        <!-- Companion Count -->
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-muted">Companions Coming Along</label>
                            <InputSelect class="form-select" @bind-Value="model.CompanionCount">
                                <option value="0">0 (Just me)</option>
                                <option value="1">1 Companion</option>
                                <option value="2">2 Companions</option>
                                <option value="3">3 Companions</option>
                                <option value="4">4+ Companions</option>
                            </InputSelect>
                        </div>

                        <!-- Dental Notes & History -->
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted">Dental History & Specific Goals</label>
                            <InputTextArea class="form-control" rows="4" @bind-Value="model.Notes" placeholder="Describe your dental requirements, tooth numbers, current discomfort, or if you already have digital OPG panorex X-rays ready to email..." />
                        </div>

                        <!-- Trust Checkbox -->
                        <div class="col-12">
                            <div class="form-check p-3 rounded-2 bg-light border">
                                <InputCheckbox class="form-check-input" id="consentCheck" @bind-Value="model.Consent" />
                                <label class="form-check-label small text-muted" for="consentCheck">
                                    I agree to receive a free written treatment plan in Philippine Pesos (PHP) directly from the clinic. My medical data is transmitted privately with zero advertising spam.
                                </label>
                                <ValidationMessage For="@(() => model.Consent)" class="text-danger small mt-1" />
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <div class="col-12 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg w-100 py-3 fw-bold" disabled="@isSubmitting">
                                @(isSubmitting ? "Sending…" : "Submit treatment request")
                            </button>
                        </div>
                    </div>
                </EditForm>
            </div>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public int? ClinicId { get; set; }

    [SupplyParameterFromQuery]
    public int? ProcedureId { get; set; }

    private InquiryFormModel model = new();
    private List<Clinic> clinics = new();
    private List<Procedure> availableProcedures = new();
    private bool isSubmitted = false;
    private bool isSubmitting = false;
    private Inquiry? submittedInquiry;
    private string confirmedClinicName = "";
    private string confirmedProcName = "";

    protected override async Task OnInitializedAsync()
    {
        clinics = await CatalogService.GetClinicsAsync();

        if (ClinicId.HasValue && ClinicId.Value > 0)
        {
            model.ClinicId = ClinicId.Value;
        }
        else if (clinics.Count > 0)
        {
            model.ClinicId = clinics.First().Id;
        }

        UpdateAvailableProcedures();

        if (ProcedureId.HasValue && ProcedureId.Value > 0
            && availableProcedures.Any(p => p.Id == ProcedureId.Value))
        {
            model.ProcedureId = ProcedureId.Value;
        }
        else if (availableProcedures.Count > 0)
        {
            model.ProcedureId = availableProcedures.First().Id;
        }

        model.PreferredDate = DateTime.Today.AddDays(30);
    }

    private void OnClinicSelectionChanged()
    {
        var currentType = availableProcedures.FirstOrDefault(p => p.Id == model.ProcedureId)?.Type;
        UpdateAvailableProcedures();
        var sameType = currentType.HasValue
            ? availableProcedures.FirstOrDefault(p => p.Type == currentType.Value)
            : null;
        if (sameType is not null)
        {
            model.ProcedureId = sameType.Id;
        }
        else if (availableProcedures.Count > 0)
        {
            model.ProcedureId = availableProcedures.First().Id;
        }
        else
        {
            model.ProcedureId = 0;
        }
    }

    private void UpdateAvailableProcedures()
    {
        var selClinic = clinics.FirstOrDefault(c => c.Id == model.ClinicId);
        availableProcedures = selClinic?.Procedures ?? new List<Procedure>();
    }

    private async Task HandleValidSubmit()
    {
        if (isSubmitting) return;
        isSubmitting = true;
        try
        {
            var selClinic = clinics.FirstOrDefault(c => c.Id == model.ClinicId);
            confirmedClinicName = selClinic?.Name ?? "Selected Clinic";
            var selProc = availableProcedures.FirstOrDefault(p => p.Id == model.ProcedureId);
            confirmedProcName = selProc != null ? $"{selProc.Type} (₱{selProc.PricePhp:N0} PHP)" : "Dental Procedure";

            submittedInquiry = await InquiryService.SubmitAsync(
                model.ClinicId,
                model.ProcedureId,
                model.PatientName,
                model.Contact,
                model.HomeCountry,
                model.PreferredDate,
                model.CompanionCount,
                model.Notes ?? ""
            );

            isSubmitted = true;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void ResetForm()
    {
        model = new InquiryFormModel
        {
            ClinicId = clinics.FirstOrDefault()?.Id ?? 0,
            HomeCountry = "Cebu City",
            PreferredDate = DateTime.Today.AddDays(30),
            Consent = true
        };
        UpdateAvailableProcedures();
        if (availableProcedures.Count > 0)
        {
            model.ProcedureId = availableProcedures.First().Id;
        }
        isSubmitted = false;
        isSubmitting = false;
        submittedInquiry = null;
    }

    public class InquiryFormModel : IValidatableObject
    {
        [Required(ErrorMessage = "Please select a clinic")]
        [Range(1, int.MaxValue, ErrorMessage = "Please select a clinic")]
        public int ClinicId { get; set; }

        [Required(ErrorMessage = "Please select a procedure")]
        [Range(1, int.MaxValue, ErrorMessage = "Please select a procedure")]
        public int ProcedureId { get; set; }

        [Required(ErrorMessage = "Please enter your full name")]
        [MinLength(2, ErrorMessage = "Name must be at least 2 characters")]
        public string PatientName { get; set; } = "";

        [Required(ErrorMessage = "Please enter your email or phone number")]
        [MinLength(5, ErrorMessage = "Contact must be at least 5 characters")]
        public string Contact { get; set; } = "";

        [Required(ErrorMessage = "Please tell us where you are based")]
        public string HomeCountry { get; set; } = "Cebu City";

        public DateTime? PreferredDate { get; set; }

        public int CompanionCount { get; set; } = 0;

        public string? Notes { get; set; }

        [Range(typeof(bool), "true", "true", ErrorMessage = "Please agree to receive your treatment plan")]
        public bool Consent { get; set; } = true;

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (PreferredDate.HasValue && PreferredDate.Value.Date < DateTime.Today)
                yield return new ValidationResult("Preferred date cannot be in the past", new[] { nameof(PreferredDate) });
        }
    }
}
