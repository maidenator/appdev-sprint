@page "/"
@rendermode InteractiveServer
@using Microsoft.JSInterop
@using appdev_sprint.Components.Shared
@using appdev_sprint.Models
@using appdev_sprint.Services
@inject ClinicCatalogService CatalogService
@inject IJSRuntime JSRuntime

<PageTitle>Cebu Dental Hub — Find Dentists in Metro Cebu</PageTitle>

<!-- Hero: map-led finder, single memorable ledger -->
<div class="home-hero mb-5">
    <div class="row align-items-center g-4">
        <div class="col-lg-7">
            <p class="home-kicker">Metro Cebu · PRC-licensed dentists · Prices in ₱ PHP</p>
            <h1 class="home-title">Save 50 to 70% on implants and veneers in Cebu</h1>
            <p class="home-lede">
                Connect with verified cosmetic and implant dentists in Metro Cebu — transparent peso pricing, from routine cleaning to full-mouth restoration.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <a href="compare" class="btn btn-primary btn-lg px-4">Compare clinic prices</a>
                <a href="clinics" class="btn btn-outline-dark btn-lg px-4">Explore verified clinics</a>
            </div>
            <dl class="home-facts">
                <div><dt>Verified clinics</dt><dd>@clinics.Count across Cebu</dd></div>
                <div><dt>Implant + crown from</dt><dd>₱70,000</dd></div>
                <div><dt>Quote turnaround</dt><dd>Within 24 hours</dd></div>
            </dl>
        </div>
        <div class="col-lg-5">
            <aside class="ledger-card" aria-label="Sample Cebu price ranges">
                <h2 class="ledger-title">Sample Cebu prices</h2>
                <div class="ledger-row"><span>Implant + crown</span><strong>₱70,000 – ₱150,000</strong></div>
                <div class="ledger-row"><span>Veneer, per tooth</span><strong>₱15,000 – ₱30,000</strong></div>
                <div class="ledger-row"><span>All-on-4, per arch</span><strong>₱400,000 – ₱800,000</strong></div>
                <a href="request" class="btn btn-dark w-100 mt-3">Request a free treatment plan</a>
                <p class="ledger-note">Itemized in PHP. Clinics confirm in writing.</p>
            </aside>
        </div>
    </div>
</div>

<!-- Standards strip: ledger, not icon tiles -->
<ul class="standards-strip mb-5">
    <li><i class="bi bi-patch-check" aria-hidden="true"></i><div><strong>PRC licensed</strong><span>Verified board dentists</span></div></li>
    <li><i class="bi bi-box-seam" aria-hidden="true"></i><div><strong>Global systems</strong><span>Osstem, Straumann, Nobel</span></div></li>
    <li><i class="bi bi-shield-check" aria-hidden="true"></i><div><strong>Class B autoclave</strong><span>Strict sterilization protocol</span></div></li>
    <li><i class="bi bi-geo-alt" aria-hidden="true"></i><div><strong>Mactan recovery</strong><span>Near beachside stays</span></div></li>
</ul>

<!-- Interactive Map & Filter Section -->
<div class="mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-end mb-3 gap-2">
        <div>
            <h2 class="mb-1">Explore Metro Cebu dental clinics</h2>
            <p class="text-muted mb-0">Filter by procedure, budget, and accreditation. Select a card to highlight its map pin.</p>
        </div>
        <a href="clinics" class="btn btn-outline-dark btn-sm">View all clinic listings</a>
    </div>

    <!-- Quick Filter Bar -->
    <div class="filter-bar-card mb-4">
        <div class="row g-3 align-items-center">
            <div class="col-md-4">
                <label class="form-label small fw-bold text-muted mb-1" for="home-procedure">Target procedure</label>
                <select id="home-procedure" class="form-select" @onchange="OnProcedureChanged">
                    <option value="">All procedures</option>
                    <option value="Implant">Dental implant (₱65k - ₱150k)</option>
                    <option value="AllOn4">All-on-4 full arch (₱400k - ₱800k)</option>
                    <option value="Veneer">Porcelain veneers (₱15k - ₱30k/tooth)</option>
                    <option value="Crown">Porcelain/zirconia crown (₱8k - ₱22k)</option>
                    <option value="Cleaning">Dental cleaning (₱300 - ₱2.5k)</option>
                    <option value="Whitening">Laser whitening</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-bold text-muted mb-1" for="home-budget">Max treatment budget: <strong>@(selectedMaxPrice.HasValue ? $"₱{selectedMaxPrice.Value:N0}" : "Any price")</strong></label>
                <input id="home-budget" type="range" class="form-range" min="10000" max="700000" step="10000"
                       value="@(selectedMaxPrice ?? 700000)"
                       @oninput="OnPriceChanged" />
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-bold text-muted mb-1" for="home-accred">Accreditation</label>
                <select id="home-accred" class="form-select" @onchange="OnAccreditationChanged">
                    <option value="">Any accreditation</option>
                    <option value="ISO">ISO certified</option>
                    <option value="PhilHealth">PhilHealth accredited</option>
                    <option value="JCI">JCI affiliated</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Map & Side List Grid -->
    <div class="row g-4">
        <div class="col-lg-7">
            <LeafletMap Pins="@pins" SelectedPinId="@selectedClinicId" OnPinSelected="@HandlePinSelected" Height="480px" />
            <div class="d-flex justify-content-between align-items-center mt-2 px-1 text-muted small">
                <span>Interactive map: select a pin to inspect the clinic profile.</span>
                <span class="badge text-bg-light border">@pins.Count pins shown</span>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="d-flex flex-column gap-3 home-clinic-list">
                @if (clinics.Count == 0)
                {
                    <div class="alert alert-info py-4 text-center">
                        No clinics match the current filter criteria. Try expanding your price or procedure filter.
                    </div>
                }
                else
                {
                    @foreach (var clinic in clinics)
                    {
                        var isSelected = clinic.Id == selectedClinicId;
                        <div id="clinic-card-@clinic.Id" class="clinic-card @(isSelected ? "is-selected" : "")" @onclick="() => SelectClinic(clinic.Id)">
                            <div class="d-flex justify-content-between align-items-start mb-2 gap-2">
                                <div>
                                    <h3 class="clinic-name">@clinic.Name</h3>
                                    <div class="text-muted small">@clinic.Area, @clinic.City</div>
                                </div>
                                @if (clinic.IsHospitalDepartment)
                                {
                                    <span class="badge text-bg-light border">Hospital dept</span>
                                }
                            </div>

                            <div class="d-flex flex-wrap gap-1 mb-3">
                                @foreach (var acc in clinic.Accreditations.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <span class="badge @(acc.Contains("ISO") ? "badge-iso" : "badge-philhealth")">@acc</span>
                                }
                                <span class="badge badge-system">Implant: @clinic.ImplantSystems</span>
                            </div>

                            <div class="ledger-rule d-flex justify-content-between align-items-center pt-2">
                                <div>
                                    <span class="text-muted small">Procedures from</span>
                                    <div class="price fw-bold">
                                        ₱@(clinic.Procedures.Count > 0 ? clinic.Procedures.Min(p => p.PricePhp).ToString("N0") : "N/A") PHP
                                    </div>
                                </div>
                                <a href="clinics/@clinic.Id" class="btn btn-sm btn-outline-dark fw-semibold" @onclick:stopPropagation="true">
                                    View pricing
                                </a>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- Comparison Callout -->
<div class="compare-callout mb-5">
    <div class="row align-items-center g-4">
        <div class="col-lg-8">
            <h2 class="mb-2">How do Cebu clinic prices compare?</h2>
            <p class="text-secondary mb-3">
                See transparent per-procedure prices side by side — implants, veneers, crowns, and full-arch restoration across Metro Cebu.
            </p>
            <a href="compare" class="btn btn-primary px-4 fw-bold">Open comparison tool</a>
        </div>
        <div class="col-lg-4">
            <div class="ledger-card ledger-card-compact">
                <div class="small fw-bold text-muted mb-2">Sample ranges (PHP)</div>
                <div class="ledger-row"><span>Implant + crown</span><strong>₱70,000 – ₱150,000</strong></div>
                <div class="ledger-row"><span>Veneer per tooth</span><strong>₱15,000 – ₱30,000</strong></div>
                <div class="ledger-row"><span>All-on-4 per arch</span><strong>₱400,000 – ₱800,000</strong></div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<ClinicPin> pins = new();
    private List<Clinic> clinics = new();
    private int? selectedClinicId;
    private ProcedureType? selectedProcedure;
    private decimal? selectedMaxPrice;
    private string? selectedAccreditation;

    protected override async Task OnInitializedAsync()
    {
        await LoadClinics();
    }

    private async Task LoadClinics()
    {
        var filter = new ClinicFilter(selectedProcedure, selectedMaxPrice, selectedAccreditation);
        pins = await CatalogService.GetPinsAsync(filter);
        clinics = await CatalogService.GetClinicsAsync(filter);
        if (selectedClinicId.HasValue && !pins.Any(p => p.Id == selectedClinicId.Value))
        {
            selectedClinicId = null;
        }
    }

    private async Task OnProcedureChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(val))
        {
            selectedProcedure = null;
        }
        else if (Enum.TryParse<ProcedureType>(val, out var parsed))
        {
            selectedProcedure = parsed;
        }
        await LoadClinics();
    }

    private async Task OnPriceChanged(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var p))
        {
            selectedMaxPrice = p;
        }
        else
        {
            selectedMaxPrice = null;
        }
        await LoadClinics();
    }

    private async Task OnAccreditationChanged(ChangeEventArgs e)
    {
        selectedAccreditation = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value.ToString();
        await LoadClinics();
    }

    private async Task HandlePinSelected(int clinicId)
    {
        selectedClinicId = clinicId;
        StateHasChanged();
        try { await JSRuntime.InvokeVoidAsync("cebuMapInterop.scrollToCard", clinicId); }
        catch (JSDisconnectedException) { }
    }

    private void SelectClinic(int clinicId)
    {
        selectedClinicId = clinicId;
        StateHasChanged();
    }
}
