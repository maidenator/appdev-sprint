@page "/clinics/{Id:int}"
@rendermode InteractiveServer
@using appdev_sprint.Components.Shared
@using appdev_sprint.Models
@using appdev_sprint.Services
@inject ClinicCatalogService CatalogService

<PageTitle>@(clinic != null ? $"{clinic.Name} — Metro Cebu Dental" : "Clinic Details — Cebu Dental Hub")</PageTitle>

@if (clinic == null)
{
    <div class="card p-5 text-center my-5">
        <h3 class="fw-bold">Clinic Not Found</h3>
        <p class="text-muted">The requested clinic profile could not be located in the Metro Cebu hub.</p>
        <div>
            <a href="clinics" class="btn btn-primary">Return to Clinics Directory</a>
        </div>
    </div>
}
else
{
    <!-- Breadcrumb & Back Link -->
    <div class="mb-3">
        <a href="clinics" class="text-decoration-none text-muted small fw-semibold">
            &larr; Back to all Metro Cebu clinics
        </a>
    </div>

    <!-- Clinic Header -->
    <div class="card rounded-4 p-4 mb-4">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <span class="badge text-bg-success">Verified center</span>
                    @if (clinic.IsHospitalDepartment)
                    {
                        <span class="badge text-bg-light border">Hospital dental dept</span>
                    }
                    <span class="badge text-bg-light border">Cebu Hub ID #@clinic.Id</span>
                </div>
                <h1 class="mb-2">@clinic.Name</h1>
                <div class="d-flex flex-wrap align-items-center gap-3 text-muted">
                    <span>
                        <strong>@clinic.Area</strong>, @clinic.City, Cebu, Philippines
                    </span>
                    <span>&bull;</span>
                    <span>
                        Languages: <strong>@clinic.Languages</strong>
                    </span>
                    <span>&bull;</span>
                    @if (!string.IsNullOrWhiteSpace(clinic.Contact))
                    {
                        <span>
                            @clinic.Contact
                        </span>
                    }
                    else
                    {
                        <span>Contact via hub inquiry form</span>
                    }
                </div>
            </div>
            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                <a href="request?clinicId=@clinic.Id" class="btn btn-lg btn-primary px-4 py-2">
                    Request itemized quote
                </a>
            </div>
        </div>
    </div>

    <!-- Trust Checklist & Guarantees -->
    <div class="card rounded-3 p-4 mb-4 bg-white">
        <h2 class="h5 mb-3">Trust and quality checklist</h2>
        <div class="row g-3">
            <div class="col-md-3 col-sm-6">
                <div class="p-3 rounded-3 border bg-light h-100">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="text-success fw-bold">✓</span>
                        <strong style="font-size: 0.9rem;">PRC Licensed</strong>
                    </div>
                    <div class="small text-muted">
                        All attending dental surgeons hold verified Professional Regulation Commission licenses.
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="p-3 rounded-3 border bg-light h-100">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="text-success fw-bold">✓</span>
                        <strong style="font-size: 0.9rem;">Implant Systems</strong>
                    </div>
                    <div class="small text-muted">
                        Official fixtures: <strong>@clinic.ImplantSystems</strong> with serial lot verification cards.
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="p-3 rounded-3 border bg-light h-100">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="text-success fw-bold">✓</span>
                        <strong style="font-size: 0.9rem;">Sterilization Protocol</strong>
                    </div>
                    <div class="small text-muted">
                        Hospital-grade Class B Autoclave cycles, single-use barriers, and biological spore monitoring.
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="p-3 rounded-3 border bg-light h-100">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="text-success fw-bold">✓</span>
                        <strong style="font-size: 0.9rem;">Written Quote Guarantee</strong>
                    </div>
                    <div class="small text-muted">
                        Binding itemized treatment plan in PHP with zero hidden chair or anaesthesia fees.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Procedures & Pricing Table -->
    <div class="card rounded-3 p-4 mb-4 bg-white">
        <div class="d-flex justify-content-between align-items-center mb-3 gap-2">
            <div>
                <h2 class="h5 mb-1">Procedures, PHP pricing and visit schedule</h2>
                <p class="text-muted small mb-0">Chair days, recovery nights, and visit scheduling.</p>
            </div>
            <span class="badge text-bg-light border">July 2026 price anchors</span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 compare-table">
                <thead class="small">
                    <tr>
                        <th>Procedure</th>
                        <th class="text-end">Price (PHP)</th>
                        <th>Visits needed</th>
                        <th>Chair vs recovery</th>
                        <th>Package inclusions</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var proc in clinic.Procedures)
                    {
                        <tr>
                            <td>
                                <strong class="text-dark">@proc.Type</strong>
                                @if (proc.ComplicationExtension)
                                {
                                    <div class="small text-primary"><i class="bi bi-shield-plus me-1"></i>Extended Stay Guarantee</div>
                                }
                            </td>
                            <td class="text-end">
                                <div class="h6 fw-bold text-success mb-0">₱@proc.PricePhp.ToString("N0")</div>
                            </td>
                            <td>
                                @if (proc.TwoTrips)
                                {
                                    <span class="badge badge-trip-two d-inline-block p-2" style="font-size: 0.75rem;">
                                        2 Visits Needed
                                    </span>
                                    <div class="small text-muted mt-1" style="font-size: 0.75rem;">
                                        Crown fitted 3–6 mo. after placement
                                    </div>
                                }
                                else
                                {
                                    <span class="badge badge-trip-single d-inline-block p-2" style="font-size: 0.75rem;">
                                        Single Visit (3–5 Days)
                                    </span>
                                    <div class="small text-muted mt-1" style="font-size: 0.75rem;">
                                        Completed in one visit
                                    </div>
                                }
                            </td>
                            <td>
                                <div>@proc.ChairDays chair day@(proc.ChairDays == 1 ? "" : "s")</div>
                                <div class="text-muted small">@proc.RecoveryNights recovery night@(proc.RecoveryNights == 1 ? "" : "s")</div>
                            </td>
                            <td>
                                <div class="small text-secondary">
                                    @foreach (var inc in proc.Inclusions.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        <span class="badge bg-light text-dark border me-1 mb-1">✓ @inc</span>
                                    }
                                </div>
                            </td>
                            <td class="text-end">
                                <a href="request?clinicId=@clinic.Id&procedureId=@proc.Id" class="btn btn-sm btn-outline-dark fw-bold">
                                    Inquire
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Recovery & Aftercare -->
    <div class="row g-4 mb-4">
        <div class="col-lg-7">
            <div class="card rounded-3 p-4 bg-white h-100">
                <h2 class="h5 mb-2">Recovery and aftercare in Cebu</h2>
                <p class="text-muted small">
                    What to expect after your appointment, and how follow-ups work at this clinic.
                </p>

                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="p-3 rounded-3 border bg-light">
                            <h6 class="fw-bold mb-1 text-dark">Free Follow-up Checkups</h6>
                            <p class="text-muted small mb-0">
                                Post-treatment reviews are typically free. Implants return once more in 3–6 months for the permanent crown.
                            </p>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 rounded-3 border bg-light">
                            <h6 class="fw-bold mb-1 text-dark">Soft-Food Aftercare</h6>
                            <p class="text-muted small mb-0">
                                Lugaw, sopas, mashed root crops, and fresh buko juice for the first few days. Avoid hot, spicy, and crunchy food.
                            </p>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 rounded-3 border bg-light">
                            <h6 class="fw-bold mb-1 text-dark">Getting There</h6>
                            <p class="text-muted small mb-0">
                                Most clinics sit near malls or main roads — jeep, taxi, or Grab. Ask the clinic for the nearest landmark and parking.
                            </p>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 rounded-3 border bg-light">
                            <h6 class="fw-bold mb-1 text-dark">Urgent Concerns</h6>
                            <p class="text-muted small mb-0">
                                Bleeding that won't stop, severe swelling, or fever after a procedure? Contact the clinic right away — details above.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Mini Clinic Map -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-3 p-4 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h4 class="h6 fw-bold mb-0">Clinic location</h4>
                    <span class="badge bg-light text-dark border">@clinic.Area</span>
                </div>
                <LeafletMap Pins="@clinicPins" SelectedPinId="@clinic.Id" Height="280px" />
                <div class="mt-2 text-muted small text-center">
                    <i class="bi bi-geo-alt text-danger"></i> @clinic.Area, @clinic.City
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private ClinicDetail? clinic;
    private List<ClinicPin> clinicPins = new();

    protected override async Task OnParametersSetAsync()
    {
        clinic = await CatalogService.GetDetailAsync(Id);
        if (clinic != null)
        {
            clinicPins = new List<ClinicPin>
            {
                new(clinic.Id, clinic.Name, clinic.Area, clinic.City, clinic.Latitude, clinic.Longitude)
            };
        }
    }
}
