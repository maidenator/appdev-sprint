@page "/compare"
@rendermode InteractiveServer
@using appdev_sprint.Components.Shared
@using appdev_sprint.Models
@using appdev_sprint.Services
@inject ClinicCatalogService CatalogService

<PageTitle>Compare Dental Clinic Prices in Cebu</PageTitle>

<div class="mb-4">
    <span class="badge bg-teal text-white mb-2 px-3 py-1" style="background-color: #00a896;">Price Transparency</span>
    <h1 class="display-6 fw-bold mb-1" style="color: #0a2540;">Side-by-Side Clinic Price Comparison</h1>
    <p class="text-muted">Compare transparent treatment prices across Metro Cebu clinics, in Philippine Pesos. No travel math — you're already here.</p>
</div>

<!-- Calculator Controls Bar -->
<div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
    <div class="row g-3 align-items-end">
        <div class="col-md-4 col-sm-6">
            <label class="form-label small fw-bold text-muted">1. Select Procedure</label>
            <select class="form-select form-select-lg" @onchange="OnProcedureChanged" value="@selectedProcedure">
                <option value="Implant">Dental Implant (Single + Crown)</option>
                <option value="AllOn4">All-on-4 Full Arch</option>
                <option value="Veneer">Porcelain Veneer (per tooth)</option>
                <option value="Crown">Porcelain/Zirconia Crown</option>
            </select>
        </div>

        <div class="col-md-4 col-sm-6">
            <button class="btn btn-primary btn-lg w-100 shadow-sm fw-bold" style="background-color: #00a896; border-color: #009383;" @onclick="Recalculate">
                Update Comparison
            </button>
        </div>
    </div>

    <!-- Clinic Selector Checkboxes (Up to 3) -->
    <div class="mt-4 pt-3 border-top">
        <label class="form-label small fw-bold text-muted d-block mb-2">Select up to 3 Metro Cebu Clinics to Compare Side-by-Side:</label>
        <div class="d-flex flex-wrap gap-3">
            @foreach (var c in allAvailableClinics)
            {
                var isChecked = selectedClinicIds.Contains(c.Id);
                <div class="form-check form-check-inline border rounded-3 px-3 py-2 bg-light">
                    <input class="form-check-input" type="checkbox" id="clinic-check-@c.Id"
                           checked="@isChecked"
                           disabled="@(!isChecked && selectedClinicIds.Count >= 3)"
                           @onchange="(e) => ToggleClinic(c.Id, (bool?)e.Value ?? false)" />
                    <label class="form-check-label fw-semibold" for="clinic-check-@c.Id">
                        @c.Name <span class="text-muted small">(@c.Area)</span>
                    </label>
                </div>
            }
        </div>
        @if (selectedClinicIds.Count >= 3)
        {
            <div class="small text-muted mt-1">Maximum 3 clinics selected for side-by-side comparison.</div>
        }
    </div>
</div>

<!-- Comparison Results -->
@if (clinicPrices.Count == 0)
{
    <div class="alert alert-warning py-4 text-center">
        No clinics offer this procedure for the current selection. Please select at least one clinic above.
    </div>
}
else
{
    var bestPrice = clinicPrices.Min(q => q.Procedure.PricePhp);
    <!-- Comparison Cards Grid -->
    <div class="row g-4 mb-4">
        @foreach (var quote in clinicPrices)
        {
            var isBest = quote.Procedure.PricePhp == bestPrice;
            <div class="col-lg-4 col-md-6">
                <div class="card border-0 shadow rounded-4 overflow-hidden h-100 bg-white">
                    <!-- Card Top Price Banner -->
                    <div class="p-3 text-white text-center" style="background: linear-gradient(135deg, #00a896 0%, #00627d 100%);">
                        <span class="text-uppercase small fw-bold" style="letter-spacing: 0.05em; opacity: 0.9;">Treatment Price</span>
                        <div class="display-6 fw-bold">
                            ₱@quote.Procedure.PricePhp.ToString("N0")
                        </div>
                        @if (isBest)
                        {
                            <span class="badge bg-warning text-dark fw-bold px-3 py-1">
                                Best price in Cebu
                            </span>
                        }
                    </div>

                    <!-- Card Body Breakdown -->
                    <div class="p-4 d-flex flex-column justify-content-between flex-grow-1">
                        <div>
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h4 class="h5 fw-bold mb-0 text-dark">@quote.ClinicName</h4>
                                    <span class="text-muted small"><i class="bi bi-geo-alt"></i> @quote.ClinicArea, Cebu</span>
                                </div>
                            </div>

                            <hr class="my-3 text-muted" />

                            <div class="small fw-bold text-muted mb-2 text-uppercase" style="letter-spacing: 0.04em;">@quote.Procedure.Type — What's Included:</div>

                            <div class="d-flex justify-content-between py-1 border-bottom small">
                                <span>Visits needed</span>
                                @if (quote.Procedure.TwoTrips)
                                {
                                    <strong class="text-dark">2 visits <span class="text-muted fw-normal">(crown fitted 3–6 mo. later)</span></strong>
                                }
                                else
                                {
                                    <strong class="text-dark">1 visit (3–5 days)</strong>
                                }
                            </div>

                            <div class="d-flex justify-content-between py-1 border-bottom small">
                                <span>Chair time / recovery</span>
                                <span class="text-muted">@quote.Procedure.ChairDays chair day@(quote.Procedure.ChairDays == 1 ? "" : "s") · @quote.Procedure.RecoveryNights recovery night@(quote.Procedure.RecoveryNights == 1 ? "" : "s")</span>
                            </div>

                            <div class="py-1 small text-muted">
                                @quote.Procedure.Inclusions
                            </div>
                        </div>

                        <!-- Card CTA -->
                        <div class="pt-2">
                            <a href="request?clinicId=@quote.ClinicId" class="btn btn-primary w-100 py-2 fw-bold shadow-sm" style="background-color: #00627d; border-color: #004d61;">
                                Request a Quote &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Notes -->
    <div class="card border-0 bg-light p-4 rounded-3 text-muted small">
        <h6 class="fw-bold text-dark mb-2"><i class="bi bi-info-circle me-1"></i> About These Prices:</h6>
        <ul class="mb-0 ps-3">
            <li><strong>Prices in Philippine Pesos (PHP):</strong> indicative per-clinic anchors to compare at a glance — always confirm a written quote with the clinic.</li>
            <li><strong>Implants need 2 visits:</strong> placement first, permanent crown 3–6 months later after the bone heals. Veneers and crowns finish in a single visit.</li>
        </ul>
    </div>
}

@code {
    private ProcedureType selectedProcedure = ProcedureType.Implant;

    private List<Clinic> allAvailableClinics = new();
    private HashSet<int> selectedClinicIds = new() { 1, 2, 3 }; // Defaults to Banilad, IT Park, Mandaue
    private List<ClinicPrice> clinicPrices = new();

    protected override async Task OnInitializedAsync()
    {
        allAvailableClinics = await CatalogService.GetClinicsAsync();
        await Recalculate();
    }

    private async Task OnProcedureChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<ProcedureType>(e.Value?.ToString(), out var proc))
        {
            selectedProcedure = proc;
            await Recalculate();
        }
    }

    private async Task ToggleClinic(int clinicId, bool isChecked)
    {
        if (isChecked)
        {
            if (selectedClinicIds.Count < 3)
            {
                selectedClinicIds.Add(clinicId);
            }
        }
        else
        {
            selectedClinicIds.Remove(clinicId);
        }
        await Recalculate();
    }

    private async Task Recalculate()
    {
        clinicPrices = await CatalogService.GetPricesAsync(
            selectedProcedure,
            selectedClinicIds.ToArray()
        );
    }
}
