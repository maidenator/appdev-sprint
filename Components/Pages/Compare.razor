@page "/compare"
@using appdev_sprint.Components.Shared
@using appdev_sprint.Models
@using appdev_sprint.Services
@inject ClinicCatalogService CatalogService

<PageTitle>Cebu Dental Tourism Package Savings Calculator</PageTitle>

<div class="mb-4">
    <span class="badge bg-teal text-white mb-2 px-3 py-1" style="background-color: #00a896;">Cost Savings Engine</span>
    <h1 class="display-6 fw-bold mb-1" style="color: #0a2540;">Side-by-Side Dental Package Savings Calculator</h1>
    <p class="text-muted">Compare home-country dental costs (US, Australia, UK) against complete Cebu tourism packages including treatment, hotel accommodation, airport transfers, and companion daily expenses.</p>
</div>

<!-- Calculator Controls Bar -->
<div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
    <div class="row g-3 align-items-end">
        <div class="col-md-3 col-sm-6">
            <label class="form-label small fw-bold text-muted">1. Select Procedure</label>
            <select class="form-select form-select-lg" @onchange="OnProcedureChanged" value="@selectedProcedure">
                <option value="Implant">Dental Implant (Single + Crown)</option>
                <option value="AllOn4">All-on-4 Full Arch</option>
                <option value="Veneer">Porcelain Veneer (per tooth)</option>
                <option value="Crown">Porcelain/Zirconia Crown</option>
            </select>
        </div>

        <div class="col-md-3 col-sm-6">
            <label class="form-label small fw-bold text-muted">2. Home Country Price Anchor</label>
            <select class="form-select form-select-lg" @onchange="OnCountryChanged" value="@selectedCountry">
                <option value="United States">🇺🇸 United States (USD)</option>
                <option value="Australia">🇦🇺 Australia (AUD converted to USD)</option>
                <option value="United Kingdom">🇬🇧 United Kingdom (GBP converted to USD)</option>
            </select>
            <div class="form-text text-muted small" style="font-size: 0.75rem;">* Note: South Korea excluded (not cheaper for foreign dental travelers).</div>
        </div>

        <div class="col-md-3 col-sm-6">
            <label class="form-label small fw-bold text-muted">3. Companion Count</label>
            <select class="form-select form-select-lg" @onchange="OnCompanionChanged" value="@companionCount">
                <option value="0">Solo Traveler (0 companions)</option>
                <option value="1">1 Traveling Companion</option>
                <option value="2">2 Traveling Companions</option>
                <option value="3">3 Traveling Companions</option>
            </select>
        </div>

        <div class="col-md-3 col-sm-6">
            <button class="btn btn-primary btn-lg w-100 shadow-sm fw-bold" style="background-color: #00a896; border-color: #009383;" @onclick="Recalculate">
                Update Comparison
            </button>
        </div>
    </div>

    <!-- Clinic Selector Checkboxes (Up to 3) -->
    <div class="mt-4 pt-3 border-top">
        <label class="form-label small fw-bold text-muted d-block mb-2">Select up to 3 Metro Cebu Clinics to Compare Side-by-Side:</label>
        <div class="d-flex flex-wrap gap-3">
            @foreach (var c in allAvailableClinics)
            {
                var isChecked = selectedClinicIds.Contains(c.Id);
                <div class="form-check form-check-inline border rounded-3 px-3 py-2 bg-light">
                    <input class="form-check-input" type="checkbox" id="clinic-check-@c.Id"
                           checked="@isChecked"
                           disabled="@(!isChecked && selectedClinicIds.Count >= 3)"
                           @onchange="(e) => ToggleClinic(c.Id, (bool?)e.Value ?? false)" />
                    <label class="form-check-label fw-semibold" for="clinic-check-@c.Id">
                        @c.Name <span class="text-muted small">(@c.Area)</span>
                    </label>
                </div>
            }
        </div>
        @if (selectedClinicIds.Count >= 3)
        {
            <div class="small text-muted mt-1">Maximum 3 clinics selected for side-by-side comparison.</div>
        }
    </div>
</div>

<!-- Comparison Results -->
@if (packageQuotes.Count == 0)
{
    <div class="alert alert-warning py-4 text-center">
        No price anchors or clinics found for this selection. Please select at least one clinic above.
    </div>
}
else
{
    var firstQuote = packageQuotes.First();
    <!-- Home Country Baseline Bar -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-light">
        <div class="d-flex flex-wrap justify-content-between align-items-center">
            <div>
                <span class="text-uppercase small fw-bold text-muted">Baseline Home Country Estimate</span>
                <h3 class="fw-bold mb-0" style="color: #0a2540;">
                    @firstQuote.HomeCountry — @firstQuote.ProcedureType
                </h3>
            </div>
            <div class="text-end mt-2 mt-sm-0">
                <span class="text-muted small d-block">Estimated Home Procedure Price:</span>
                <span class="display-6 fw-bold text-danger">$@firstQuote.HomePriceUsd.ToString("N0") USD</span>
            </div>
        </div>
    </div>

    <!-- Comparison Cards Grid -->
    <div class="row g-4 mb-4">
        @foreach (var quote in packageQuotes)
        {
            <div class="col-lg-4 col-md-6">
                <div class="card border-0 shadow rounded-4 overflow-hidden h-100 bg-white">
                    <!-- Card Top Savings Banner -->
                    <div class="p-3 text-white text-center" style="background: linear-gradient(135deg, #00a896 0%, #00627d 100%);">
                        <span class="text-uppercase small fw-bold" style="letter-spacing: 0.05em; opacity: 0.9;">Total Net Savings</span>
                        <div class="display-6 fw-bold">
                            $@quote.SavingsUsd.ToString("N0") <span style="font-size: 1.1rem; opacity: 0.9;">USD</span>
                        </div>
                        <span class="badge bg-warning text-dark fw-bold px-3 py-1">
                            Save @quote.SavingsPct% vs Home
                        </span>
                    </div>

                    <!-- Card Body Breakdown -->
                    <div class="p-4 d-flex flex-column justify-content-between flex-grow-1">
                        <div>
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h4 class="h5 fw-bold mb-0 text-dark">@quote.ClinicName</h4>
                                    <span class="text-muted small"><i class="bi bi-geo-alt"></i> @quote.ClinicArea, Cebu</span>
                                </div>
                            </div>

                            <hr class="my-3 text-muted" />

                            <div class="small fw-bold text-muted mb-2 text-uppercase" style="letter-spacing: 0.04em;">Cebu Package Itemization:</div>

                            <div class="d-flex justify-content-between py-1 border-bottom small">
                                <span>Dental Treatment (@quote.ProcedureType)</span>
                                <strong class="text-dark">₱@quote.TreatmentPhp.ToString("N0")</strong>
                            </div>

                            <div class="d-flex justify-content-between py-1 border-bottom small">
                                <span>Hotel (@quote.StayNights nights @@ ₱3.5k)</span>
                                <span class="text-muted">₱@quote.HotelPhp.ToString("N0")</span>
                            </div>

                            <div class="d-flex justify-content-between py-1 border-bottom small">
                                <span>Airport & Clinic Transfers</span>
                                <span class="text-muted">₱@quote.TransfersPhp.ToString("N0")</span>
                            </div>

                            @if (quote.CompanionPhp > 0)
                            {
                                <div class="d-flex justify-content-between py-1 border-bottom small">
                                    <span>Companion Daily Allowance (@companionCount companion@(companionCount == 1 ? "" : "s"))</span>
                                    <span class="text-muted">₱@quote.CompanionPhp.ToString("N0")</span>
                                </div>
                            }

                            <div class="d-flex justify-content-between pt-3 pb-2 mb-3 bg-light px-2 rounded-2">
                                <span class="fw-bold text-dark">Total Cebu Package Cost:</span>
                                <div class="text-end">
                                    <div class="fw-bold text-success">₱@quote.TotalPhp.ToString("N0") PHP</div>
                                    <div class="text-muted small">≈ $@quote.TotalUsd.ToString("N0") USD</div>
                                </div>
                            </div>
                        </div>

                        <!-- Card CTA -->
                        <div class="pt-2">
                            <a href="request?clinicId=@quote.ClinicId" class="btn btn-primary w-100 py-2 fw-bold shadow-sm" style="background-color: #00627d; border-color: #004d61;">
                                Inquire for this Package &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Methodology & Domain Footnotes -->
    <div class="card border-0 bg-light p-4 rounded-3 text-muted small">
        <h6 class="fw-bold text-dark mb-2"><i class="bi bi-info-circle me-1"></i> Calculation Methodology & Assumptions:</h6>
        <ul class="mb-0 ps-3">
            <li><strong>Treatment Cost:</strong> Official seed-price anchors for accredited Metro Cebu clinics in Philippine Pesos (PHP).</li>
            <li><strong>Stay Duration:</strong> Procedure chair days + recovery nights + 4 travel buffer days.</li>
            <li><strong>Hotel:</strong> Mid-range Cebu/Mactan accommodation estimated at ₱3,500/night.</li>
            <li><strong>Transfers:</strong> Private airport and clinic return transfers estimated at ₱2,500 flat.</li>
            <li><strong>Companion Allowance:</strong> Estimated daily tourism and dining spend of ₱2,000/day per accompanying traveler.</li>
            <li><strong>Exchange Rate:</strong> Converted at reference anchor of ₱62 PHP per $1 USD. Australian Dollars (AUD) converted at 0.66; British Pounds (GBP) converted at 1.27.</li>
        </ul>
    </div>
}

@code {
    private ProcedureType selectedProcedure = ProcedureType.Implant;
    private string selectedCountry = "United States";
    private int companionCount = 0;

    private List<Clinic> allAvailableClinics = new();
    private HashSet<int> selectedClinicIds = new() { 1, 2, 3 }; // Defaults to Banilad, IT Park, Mandaue
    private List<PackageQuote> packageQuotes = new();

    protected override async Task OnInitializedAsync()
    {
        allAvailableClinics = await CatalogService.GetClinicsAsync();
        await Recalculate();
    }

    private async Task OnProcedureChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<ProcedureType>(e.Value?.ToString(), out var proc))
        {
            selectedProcedure = proc;
            await Recalculate();
        }
    }

    private async Task OnCountryChanged(ChangeEventArgs e)
    {
        selectedCountry = e.Value?.ToString() ?? "United States";
        await Recalculate();
    }

    private async Task OnCompanionChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var count))
        {
            companionCount = count;
            await Recalculate();
        }
    }

    private async Task ToggleClinic(int clinicId, bool isChecked)
    {
        if (isChecked)
        {
            if (selectedClinicIds.Count < 3)
            {
                selectedClinicIds.Add(clinicId);
            }
        }
        else
        {
            selectedClinicIds.Remove(clinicId);
        }
        await Recalculate();
    }

    private async Task Recalculate()
    {
        packageQuotes = await CatalogService.CompareAsync(
            selectedProcedure,
            selectedCountry,
            companionCount,
            selectedClinicIds.ToArray()
        );
    }
}
